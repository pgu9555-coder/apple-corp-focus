{
  "manifest_version": 3,
  "name": "Apple Corp Focus Machine",
  "version": "0.6.3",
  "description": "Choose your focus and break times, protect focus from distracting sites, and collect earned rewards with an Arduino device.",
  "minimum_chrome_version": "127",
  "permissions": [
    "alarms",
    "storage",
    "tabs",
    "webNavigation",
    "notifications",
    "offscreen",
    "idle",
    "scripting"
  ],
  "optional_host_permissions": [
    "http://*/*",
    "https://*/*"
  ],
  "background": {
    "service_worker": "background.js",
    "type": "module"
  },
  "action": {
    "default_popup": "popup.html",
    "default_title": "Apple Corp Focus Machine",
    "default_icon": {
      "16": "assets/icon16.png",
      "32": "assets/icon32.png",
      "48": "assets/icon48.png",
      "128": "assets/icon128.png"
    }
  },
  "icons": {
    "16": "assets/icon16.png",
    "32": "assets/icon32.png",
    "48": "assets/icon48.png",
    "128": "assets/icon128.png"
  },
  "options_page": "dashboard.html",
  "incognito": "not_allowed",
  "content_security_policy": {
    "extension_pages": "script-src 'self' 'wasm-unsafe-eval'; object-src 'self'; base-uri 'none'"
  }
}
